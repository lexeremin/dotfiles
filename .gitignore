.DS_Store

# pi — block everything, then explicitly allow only tracked files
pi/**
!pi/.pi/
!pi/.pi/agent/
pi/.pi/agent/*
!pi/.pi/agent/models.json
!pi/.pi/agent/settings.json
!pi/.pi/agent/themes/
pi/.pi/agent/themes/*
!pi/.pi/agent/themes/midori.json
!pi/.pi/agent/themes/eink.json

# zsh — block everything, only allow main config files
zsh/**
!zsh/.zshrc
!zsh/.zprofile
!zsh/.zlogin

# Generated by theme switcher
**/current-theme.toml
**/current-theme.conf
**/current-theme.lua
chrome/manifest.json
firefox/manifest.json
vscode/colorscheme.jsonc

*/decoration.toml
*/macos
*/linux
*.zcompdump*
*.zsh_history
.zcompcache
*.zsh_sessions

# Sensitive files — matched at any depth
**/.env
**/.env.*
**/auth.json
