<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
    <icon>utilities-terminal</icon>
    <name>Open Ghostty Here</name>
    <unique-id>open-ghostty-here</unique-id>
    <command>ghostty --working-directory=%f</command>
    <description>Open Ghostty in this directory</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
</action>
<action>
    <icon>code</icon>
    <name>Open in Neovim</name>
    <unique-id>open-nvim</unique-id>
    <command>ghostty -e nvim %f</command>
    <description>Open file in Neovim</description>
    <patterns>*</patterns>
    <text-files/>
</action>
</actions>
