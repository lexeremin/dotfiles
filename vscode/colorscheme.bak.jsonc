    },
    "tokenColors": [
        {
            "scope": [
                "variable"
            ],
            "settings": {
                "foreground": "#D1D0C5"
            }
        },
        {
            "scope": [
                "keyword.operator",
                "brace",
                "bracket",
                "delimiter",
                "meta",
                "paren",
                "tag"
            ],
            "settings": {
                "foreground": "#737579"
            }
        },
        {
            "scope": [
                "storage"
            ],
            "settings": {
                "foreground": "#737579"
            }
        },
        {
            "scope": [
                "keyword.control",
                "keyword.operator.new"
            ],
            "settings": {
                "foreground": "#EA4A5A"
            }
        },
        {
            "scope": [
                "string"
            ],
            "settings": {
                "foreground": "#D1D0C5"
            }
        },
        {
            "scope": [
                "comment"
            ],
            "settings": {
                "foreground": "#737579"
            }
        },
        {
            "scope": [
                "entity.name",
                "meta.function-call",
                "support.class"
            ],
            "settings": {
                "foreground": "#FFCB00"
            }
        },
        {
            "scope": [
                "constant"
            ],
            "settings": {
                "foreground": "#EA4A5A",
                "fontStyle": ""
            }
        },
        {
            "scope": "token.info-token",
            "settings": {
                "foreground": "#6796E6"
            }
        },
        {
            "scope": "token.warn-token",
            "settings": {
                "foreground": "#CD9731"
            }
        },
        {
            "scope": "token.error-token",
            "settings": {
                "foreground": "#EA4A5A"
            }
        },
        {
            "scope": "token.debug-token",
            "settings": {
                "foreground": "#B267E6"
            }
        }
    ]
}