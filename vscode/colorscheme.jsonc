{
    "$schema": "vscode://schemas/color-theme",
    "name": "Midori Dark",
    "type": "dark",
    "colors": {
        "activityBar.activeBorder": "#6B9AB8",
        "activityBar.background": "#1A1714",
        "activityBar.border": "#1A1714",
        "activityBar.foreground": "#6B9AB8",
        "activityBar.inactiveForeground": "#5A5550",
        "activityBarBadge.background": "#6B9AB8",
        "activityBarBadge.foreground": "#1E1B18",
        "badge.background": "#6B9AB8",
        "badge.foreground": "#1E1B18",
        "breadcrumb.activeSelectionForeground": "#E0DBD3",
        "breadcrumb.focusForeground": "#E0DBD3",
        "breadcrumb.foreground": "#8A857E",
        "breadcrumbPicker.background": "#252220",
        "button.background": "#6B9AB8",
        "button.foreground": "#1E1B18",
        "button.hoverBackground": "#5589A0",
        "button.secondaryBackground": "#252220",
        "button.secondaryForeground": "#E0DBD3",
        "button.secondaryHoverBackground": "#3A3530",
        "checkbox.background": "#252220",
        "checkbox.border": "#1E1B18",
        "debugToolBar.background": "#252220",
        "descriptionForeground": "#8A857E",
        "diffEditor.insertedTextBackground": "#8BAD7930",
        "diffEditor.removedTextBackground": "#C4607A30",
        "dropdown.background": "#252220",
        "dropdown.border": "#6B9AB8",
        "dropdown.foreground": "#E0DBD3",
        "dropdown.listBackground": "#252220",
        "editor.background": "#1E1B18",
        "editor.findMatchBackground": "#B8986840",
        "editor.findMatchBorder": "#B89868",
        "editor.findMatchHighlightBackground": "#B8986830",
        "editor.foreground": "#E0DBD3",
        "editor.inactiveSelectionBackground": "#3A353066",
        "editor.lineHighlightBackground": "#252220",
        "editor.selectionBackground": "#3A3530",
        "editor.selectionHighlightBackground": "#3A353044",
        "editor.wordHighlightBackground": "#3A353000",
        "editor.wordHighlightBorder": "#5A555066",
        "editor.wordHighlightStrongBackground": "#3A353000",
        "editor.wordHighlightStrongBorder": "#8A857E",
        "editorBracketMatch.background": "#3A353066",
        "editorBracketMatch.border": "#6B9AB800",
        "editorCursor.foreground": "#E0DBD3",
        "editorGroup.border": "#2A2724",
        "editorGroup.dropBackground": "#252220",
        "editorGroupHeader.tabsBackground": "#1A1714",
        "editorGroupHeader.tabsBorder": "#1A1714",
        "editorGutter.addedBackground": "#8BAD79",
        "editorGutter.deletedBackground": "#C4607A",
        "editorGutter.modifiedBackground": "#6B9AB8",
        "editorIndentGuide.activeBackground1": "#3A3530",
        "editorIndentGuide.background1": "#2A2724",
        "editorLineNumber.activeForeground": "#6B9AB8",
        "editorLineNumber.foreground": "#5A5550",
        "editorOverviewRuler.border": "#1A1714",
        "editorWhitespace.foreground": "#2E2A26",
        "editorWidget.background": "#252220",
        "errorForeground": "#C4607A",
        "focusBorder": "#6B9AB8",
        "foreground": "#B8B3AB",
        "gitDecoration.addedResourceForeground": "#8BAD79",
        "gitDecoration.conflictingResourceForeground": "#C4607A",
        "gitDecoration.deletedResourceForeground": "#C4607A",
        "gitDecoration.ignoredResourceForeground": "#5A5550",
        "gitDecoration.modifiedResourceForeground": "#6B9AB8",
        "gitDecoration.renamedResourceForeground": "#B89868",
        "gitDecoration.stageDeletedResourceForeground": "#C4607A",
        "gitDecoration.stageModifiedResourceForeground": "#6B9AB8",
        "gitDecoration.untrackedResourceForeground": "#B89868",
        "icon.foreground": "#6B9AB8",
        "input.background": "#252220",
        "input.border": "#1E1B18",
        "input.foreground": "#E0DBD3",
        "input.placeholderForeground": "#8A857E",
        "inputOption.activeBackground": "#6B9AB800",
        "inputOption.activeBorder": "#6B9AB8",
        "list.activeSelectionBackground": "#2E2A26",
        "list.activeSelectionForeground": "#E0DBD3",
        "list.focusBackground": "#3A3530",
        "list.hoverBackground": "#252220",
        "list.hoverForeground": "#E0DBD3",
        "list.inactiveFocusBackground": "#252220",
        "list.inactiveSelectionBackground": "#252220",
        "list.inactiveSelectionForeground": "#E0DBD3",
        "menu.selectionBackground": "#2E2A26",
        "menu.selectionForeground": "#E0DBD3",
        "menubar.selectionBackground": "#252220",
        "menubar.selectionForeground": "#E0DBD3",
        "notificationCenterHeader.background": "#252220",
        "notificationCenterHeader.foreground": "#8A857E",
        "notifications.background": "#252220",
        "notifications.border": "#1E1B18",
        "notifications.foreground": "#E0DBD3",
        "notificationsErrorIcon.foreground": "#C4607A",
        "notificationsInfoIcon.foreground": "#6B9AB8",
        "notificationsWarningIcon.foreground": "#B89868",
        "panel.background": "#1A1714",
        "panel.border": "#1A1714",
        "panelInput.border": "#1A1714",
        "panelTitle.activeBorder": "#6B9AB8",
        "panelTitle.activeForeground": "#E0DBD3",
        "panelTitle.inactiveForeground": "#8A857E",
        "peekViewEditor.background": "#1E1B1888",
        "peekViewEditor.matchHighlightBackground": "#B8986833",
        "peekViewResult.background": "#252220",
        "peekViewResult.matchHighlightBackground": "#B8986833",
        "pickerGroup.border": "#2A2724",
        "pickerGroup.foreground": "#6B9AB8",
        "progressBar.background": "#6B9AB8",
        "quickInput.background": "#252220",
        "quickInput.foreground": "#E0DBD3",
        "scrollbar.shadow": "#1E1B1800",
        "scrollbarSlider.activeBackground": "#5A555066",
        "scrollbarSlider.background": "#5A555033",
        "scrollbarSlider.hoverBackground": "#5A555044",
        "settings.headerForeground": "#E0DBD3",
        "settings.modifiedItemIndicator": "#6B9AB8",
        "sideBar.background": "#1A1714",
        "sideBar.border": "#1A1714",
        "sideBar.foreground": "#B8B3AB",
        "sideBarSectionHeader.background": "#1A1714",
        "sideBarSectionHeader.border": "#1A1714",
        "sideBarSectionHeader.foreground": "#E0DBD3",
        "sideBarTitle.foreground": "#E0DBD3",
        "statusBar.background": "#1A1714",
        "statusBar.border": "#1A1714",
        "statusBar.debuggingBackground": "#C4607A",
        "statusBar.debuggingForeground": "#E0DBD3",
        "statusBar.foreground": "#B8B3AB",
        "statusBar.noFolderBackground": "#1A1714",
        "statusBar.noFolderForeground": "#8A857E",
        "statusBarItem.prominentBackground": "#6B9AB8",
        "tab.activeBackground": "#1E1B18",
        "tab.activeBorder": "#1E1B18",
        "tab.activeForeground": "#E0DBD3",
        "tab.border": "#1A1714",
        "tab.hoverBackground": "#252220",
        "tab.inactiveBackground": "#1A1714",
        "tab.inactiveForeground": "#8A857E",
        "tab.unfocusedActiveBorder": "#1A1714",
        "tab.unfocusedHoverBackground": "#1A1714",
        "terminal.ansiBlack": "#2A2724",
        "terminal.ansiBlue": "#6B9AB8",
        "terminal.ansiBrightBlack": "#5A5550",
        "terminal.ansiBrightBlue": "#6B9AB8",
        "terminal.ansiBrightCyan": "#4E4A45",
        "terminal.ansiBrightGreen": "#8BAD79",
        "terminal.ansiBrightMagenta": "#58534C",
        "terminal.ansiBrightRed": "#C4607A",
        "terminal.ansiBrightWhite": "#E0DBD3",
        "terminal.ansiBrightYellow": "#B89868",
        "terminal.ansiCyan": "#4E4A45",
        "terminal.ansiGreen": "#8BAD79",
        "terminal.ansiMagenta": "#58534C",
        "terminal.ansiRed": "#C4607A",
        "terminal.ansiWhite": "#B8B3AB",
        "terminal.ansiYellow": "#B89868",
        "terminal.foreground": "#E0DBD3",
        "textBlockQuote.background": "#252220",
        "textBlockQuote.border": "#2A2724",
        "textCodeBlock.background": "#252220",
        "textLink.activeForeground": "#5589A0",
        "textLink.foreground": "#6B9AB8",
        "textPreformat.foreground": "#E0DBD3",
        "textSeparator.foreground": "#5A5550",
        "titleBar.activeBackground": "#1A1714",
        "titleBar.activeForeground": "#E0DBD3",
        "titleBar.border": "#1A1714",
        "titleBar.inactiveBackground": "#1A1714",
        "titleBar.inactiveForeground": "#8A857E",
        "tree.indentGuidesStroke": "#2A2724",
        "welcomePage.progress.foreground": "#6B9AB8"
    },
    "tokenColors": [
        {
            "scope": ["variable"],
            "settings": { "foreground": "#E0DBD3" }
        },
        {
            "scope": [
                "keyword.operator",
                "brace",
                "bracket",
                "delimiter",
                "meta",
                "paren",
                "tag"
            ],
            "settings": { "foreground": "#8A857E" }
        },
        {
            "scope": ["storage"],
            "settings": { "foreground": "#8A857E" }
        },
        {
            "scope": [
                "keyword.control",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#6B9AB8" }
        },
        {
            "scope": ["string"],
            "settings": { "foreground": "#8BAD79" }
        },
        {
            "scope": ["comment"],
            "settings": { "foreground": "#8A857E", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name",
                "meta.function-call",
                "support.class"
            ],
            "settings": { "foreground": "#6B9AB8" }
        },
        {
            "scope": ["constant"],
            "settings": { "foreground": "#B89868", "fontStyle": "" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6B9AB8" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#B89868" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#C4607A" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#8A857E" }
        }
    ]
}
