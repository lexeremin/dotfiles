{
    "$schema": "vscode://schemas/color-theme",
    "name": "Eink",
    "type": "light",
    "colors": {
        "activityBar.activeBorder": "#6B9AB8",
        "activityBar.background": "#B8B8B8",
        "activityBar.border": "#B8B8B8",
        "activityBar.foreground": "#6B9AB8",
        "activityBar.inactiveForeground": "#868686",
        "activityBarBadge.background": "#6B9AB8",
        "activityBarBadge.foreground": "#CCCCCC",
        "badge.background": "#6B9AB8",
        "badge.foreground": "#CCCCCC",
        "breadcrumb.activeSelectionForeground": "#474747",
        "breadcrumb.focusForeground": "#474747",
        "breadcrumb.foreground": "#868686",
        "breadcrumbPicker.background": "#D5D5D5",
        "button.background": "#6B9AB8",
        "button.foreground": "#CCCCCC",
        "button.hoverBackground": "#5589A0",
        "button.secondaryBackground": "#D5D5D5",
        "button.secondaryForeground": "#474747",
        "button.secondaryHoverBackground": "#C2C2C2",
        "checkbox.background": "#D5D5D5",
        "checkbox.border": "#B8B8B8",
        "debugToolBar.background": "#D5D5D5",
        "descriptionForeground": "#868686",
        "diffEditor.insertedTextBackground": "#8BAD7930",
        "diffEditor.removedTextBackground": "#C4607A30",
        "dropdown.background": "#D5D5D5",
        "dropdown.border": "#6B9AB8",
        "dropdown.foreground": "#474747",
        "dropdown.listBackground": "#D5D5D5",
        "editor.background": "#CCCCCC",
        "editor.findMatchBackground": "#B8986840",
        "editor.findMatchBorder": "#B89868",
        "editor.findMatchHighlightBackground": "#B8986830",
        "editor.foreground": "#474747",
        "editor.inactiveSelectionBackground": "#B8B8B866",
        "editor.lineHighlightBackground": "#C2C2C2",
        "editor.selectionBackground": "#B8B8B8",
        "editor.selectionHighlightBackground": "#B8B8B844",
        "editor.wordHighlightBackground": "#B8B8B800",
        "editor.wordHighlightBorder": "#86868666",
        "editor.wordHighlightStrongBackground": "#B8B8B800",
        "editor.wordHighlightStrongBorder": "#868686",
        "editorBracketMatch.background": "#B8B8B866",
        "editorBracketMatch.border": "#6B9AB800",
        "editorCursor.foreground": "#474747",
        "editorGroup.border": "#C2C2C2",
        "editorGroup.dropBackground": "#D5D5D5",
        "editorGroupHeader.tabsBackground": "#B8B8B8",
        "editorGroupHeader.tabsBorder": "#B8B8B8",
        "editorGutter.addedBackground": "#8BAD79",
        "editorGutter.deletedBackground": "#C4607A",
        "editorGutter.modifiedBackground": "#6B9AB8",
        "editorIndentGuide.activeBackground1": "#B8B8B8",
        "editorIndentGuide.background1": "#C2C2C2",
        "editorLineNumber.activeForeground": "#6B9AB8",
        "editorLineNumber.foreground": "#868686",
        "editorOverviewRuler.border": "#B8B8B8",
        "editorWhitespace.foreground": "#C2C2C2",
        "editorWidget.background": "#D5D5D5",
        "errorForeground": "#C4607A",
        "focusBorder": "#6B9AB8",
        "foreground": "#5E5E5E",
        "gitDecoration.addedResourceForeground": "#8BAD79",
        "gitDecoration.conflictingResourceForeground": "#C4607A",
        "gitDecoration.deletedResourceForeground": "#C4607A",
        "gitDecoration.ignoredResourceForeground": "#868686",
        "gitDecoration.modifiedResourceForeground": "#6B9AB8",
        "gitDecoration.renamedResourceForeground": "#B89868",
        "gitDecoration.stageDeletedResourceForeground": "#C4607A",
        "gitDecoration.stageModifiedResourceForeground": "#6B9AB8",
        "gitDecoration.untrackedResourceForeground": "#B89868",
        "icon.foreground": "#6B9AB8",
        "input.background": "#D5D5D5",
        "input.border": "#B8B8B8",
        "input.foreground": "#474747",
        "input.placeholderForeground": "#868686",
        "inputOption.activeBackground": "#6B9AB800",
        "inputOption.activeBorder": "#6B9AB8",
        "list.activeSelectionBackground": "#C2C2C2",
        "list.activeSelectionForeground": "#474747",
        "list.focusBackground": "#B8B8B8",
        "list.hoverBackground": "#D5D5D5",
        "list.hoverForeground": "#474747",
        "list.inactiveFocusBackground": "#D5D5D5",
        "list.inactiveSelectionBackground": "#D5D5D5",
        "list.inactiveSelectionForeground": "#474747",
        "menu.selectionBackground": "#C2C2C2",
        "menu.selectionForeground": "#474747",
        "menubar.selectionBackground": "#D5D5D5",
        "menubar.selectionForeground": "#474747",
        "notificationCenterHeader.background": "#D5D5D5",
        "notificationCenterHeader.foreground": "#868686",
        "notifications.background": "#D5D5D5",
        "notifications.border": "#B8B8B8",
        "notifications.foreground": "#474747",
        "notificationsErrorIcon.foreground": "#C4607A",
        "notificationsInfoIcon.foreground": "#6B9AB8",
        "notificationsWarningIcon.foreground": "#B89868",
        "panel.background": "#B8B8B8",
        "panel.border": "#B8B8B8",
        "panelInput.border": "#B8B8B8",
        "panelTitle.activeBorder": "#6B9AB8",
        "panelTitle.activeForeground": "#474747",
        "panelTitle.inactiveForeground": "#868686",
        "peekViewEditor.background": "#CCCCCC88",
        "peekViewEditor.matchHighlightBackground": "#B8986833",
        "peekViewResult.background": "#D5D5D5",
        "peekViewResult.matchHighlightBackground": "#B8986833",
        "pickerGroup.border": "#C2C2C2",
        "pickerGroup.foreground": "#6B9AB8",
        "progressBar.background": "#6B9AB8",
        "quickInput.background": "#D5D5D5",
        "quickInput.foreground": "#474747",
        "scrollbar.shadow": "#CCCCCC00",
        "scrollbarSlider.activeBackground": "#86868666",
        "scrollbarSlider.background": "#86868633",
        "scrollbarSlider.hoverBackground": "#86868644",
        "settings.headerForeground": "#474747",
        "settings.modifiedItemIndicator": "#6B9AB8",
        "sideBar.background": "#B8B8B8",
        "sideBar.border": "#B8B8B8",
        "sideBar.foreground": "#5E5E5E",
        "sideBarSectionHeader.background": "#B8B8B8",
        "sideBarSectionHeader.border": "#B8B8B8",
        "sideBarSectionHeader.foreground": "#474747",
        "sideBarTitle.foreground": "#474747",
        "statusBar.background": "#B8B8B8",
        "statusBar.border": "#B8B8B8",
        "statusBar.debuggingBackground": "#C4607A",
        "statusBar.debuggingForeground": "#CCCCCC",
        "statusBar.foreground": "#5E5E5E",
        "statusBar.noFolderBackground": "#B8B8B8",
        "statusBar.noFolderForeground": "#868686",
        "statusBarItem.prominentBackground": "#6B9AB8",
        "tab.activeBackground": "#CCCCCC",
        "tab.activeBorder": "#CCCCCC",
        "tab.activeForeground": "#474747",
        "tab.border": "#B8B8B8",
        "tab.hoverBackground": "#D5D5D5",
        "tab.inactiveBackground": "#B8B8B8",
        "tab.inactiveForeground": "#868686",
        "tab.unfocusedActiveBorder": "#B8B8B8",
        "tab.unfocusedHoverBackground": "#B8B8B8",
        "terminal.ansiBlack": "#CCCCCC",
        "terminal.ansiBlue": "#6B9AB8",
        "terminal.ansiBrightBlack": "#5E5E5E",
        "terminal.ansiBrightBlue": "#6B9AB8",
        "terminal.ansiBrightCyan": "#4A4A4A",
        "terminal.ansiBrightGreen": "#8BAD79",
        "terminal.ansiBrightMagenta": "#474747",
        "terminal.ansiBrightRed": "#C4607A",
        "terminal.ansiBrightWhite": "#CCCCCC",
        "terminal.ansiBrightYellow": "#B89868",
        "terminal.ansiCyan": "#4A4A4A",
        "terminal.ansiGreen": "#8BAD79",
        "terminal.ansiMagenta": "#474747",
        "terminal.ansiRed": "#C4607A",
        "terminal.ansiWhite": "#5E5E5E",
        "terminal.ansiYellow": "#B89868",
        "terminal.foreground": "#474747",
        "textBlockQuote.background": "#D5D5D5",
        "textBlockQuote.border": "#C2C2C2",
        "textCodeBlock.background": "#D5D5D5",
        "textLink.activeForeground": "#5589A0",
        "textLink.foreground": "#6B9AB8",
        "textPreformat.foreground": "#474747",
        "textSeparator.foreground": "#868686",
        "titleBar.activeBackground": "#B8B8B8",
        "titleBar.activeForeground": "#474747",
        "titleBar.border": "#B8B8B8",
        "titleBar.inactiveBackground": "#B8B8B8",
        "titleBar.inactiveForeground": "#868686",
        "tree.indentGuidesStroke": "#C2C2C2",
        "welcomePage.progress.foreground": "#6B9AB8"
    },
    "tokenColors": [
        {
            "scope": ["variable"],
            "settings": { "foreground": "#474747" }
        },
        {
            "scope": [
                "keyword.operator",
                "brace",
                "bracket",
                "delimiter",
                "meta",
                "paren",
                "tag"
            ],
            "settings": { "foreground": "#868686" }
        },
        {
            "scope": ["storage"],
            "settings": { "foreground": "#868686" }
        },
        {
            "scope": [
                "keyword.control",
                "keyword.operator.new"
            ],
            "settings": { "foreground": "#6B9AB8" }
        },
        {
            "scope": ["string"],
            "settings": { "foreground": "#8BAD79" }
        },
        {
            "scope": ["comment"],
            "settings": { "foreground": "#868686", "fontStyle": "italic" }
        },
        {
            "scope": [
                "entity.name",
                "meta.function-call",
                "support.class"
            ],
            "settings": { "foreground": "#6B9AB8" }
        },
        {
            "scope": ["constant"],
            "settings": { "foreground": "#B89868", "fontStyle": "" }
        },
        {
            "scope": "token.info-token",
            "settings": { "foreground": "#6B9AB8" }
        },
        {
            "scope": "token.warn-token",
            "settings": { "foreground": "#B89868" }
        },
        {
            "scope": "token.error-token",
            "settings": { "foreground": "#C4607A" }
        },
        {
            "scope": "token.debug-token",
            "settings": { "foreground": "#868686" }
        }
    ]
}
