{
    "$schema": "vscode://schemas/color-theme",
    "name": "Eink",
    "type": "light",
    "colors": {
        "activityBar.activeBorder": "#3E3B36",
        "activityBar.background": "#D4D0CA",
        "activityBar.border": "#D4D0CA",
        "activityBar.foreground": "#2C2926",
        "activityBar.inactiveForeground": "#9C9892",
        "activityBarBadge.background": "#3E3B36",
        "activityBarBadge.foreground": "#F2EDE8",
        "badge.background": "#3E3B36",
        "badge.foreground": "#F2EDE8",
        "breadcrumb.activeSelectionForeground": "#2C2926",
        "breadcrumb.focusForeground": "#2C2926",
        "breadcrumb.foreground": "#9C9892",
        "breadcrumbPicker.background": "#ECE8E2",
        "button.background": "#3E3B36",
        "button.foreground": "#F2EDE8",
        "button.hoverBackground": "#504D49",
        "button.secondaryBackground": "#E5E1DA",
        "button.secondaryForeground": "#2C2926",
        "button.secondaryHoverBackground": "#D4D0CA",
        "checkbox.background": "#ECE8E2",
        "checkbox.border": "#D4D0CA",
        "diffEditor.insertedTextBackground": "#5A565220",
        "diffEditor.removedTextBackground": "#3E3B3620",
        "dropdown.background": "#ECE8E2",
        "dropdown.border": "#3E3B36",
        "dropdown.foreground": "#2C2926",
        "dropdown.listBackground": "#ECE8E2",
        "editor.background": "#F2EDE8",
        "editor.findMatchBackground": "#7A767240",
        "editor.findMatchBorder": "#7A7672",
        "editor.findMatchHighlightBackground": "#7A767230",
        "editor.foreground": "#2C2926",
        "editor.inactiveSelectionBackground": "#D4D0CA66",
        "editor.lineHighlightBackground": "#E5E1DA",
        "editor.selectionBackground": "#E5E1DA",
        "editor.selectionHighlightBackground": "#E5E1DA44",
        "editor.wordHighlightBackground": "#E5E1DA00",
        "editor.wordHighlightBorder": "#9C989266",
        "editor.wordHighlightStrongBackground": "#E5E1DA00",
        "editor.wordHighlightStrongBorder": "#9C9892",
        "editorBracketMatch.background": "#D4D0CA66",
        "editorBracketMatch.border": "#3E3B3600",
        "editorCursor.foreground": "#3E3B36",
        "editorGroup.border": "#E5E1DA",
        "editorGroupHeader.tabsBackground": "#D4D0CA",
        "editorGroupHeader.tabsBorder": "#D4D0CA",
        "editorGutter.addedBackground": "#5A5652",
        "editorGutter.deletedBackground": "#3E3B36",
        "editorGutter.modifiedBackground": "#7A7672",
        "editorIndentGuide.activeBackground1": "#D4D0CA",
        "editorIndentGuide.background1": "#E5E1DA",
        "editorLineNumber.activeForeground": "#3E3B36",
        "editorLineNumber.foreground": "#9C9892",
        "editorOverviewRuler.border": "#D4D0CA",
        "editorWhitespace.foreground": "#E5E1DA",
        "editorWidget.background": "#ECE8E2",
        "errorForeground": "#2C2926",
        "focusBorder": "#3E3B36",
        "foreground": "#7A7672",
        "gitDecoration.addedResourceForeground": "#5A5652",
        "gitDecoration.conflictingResourceForeground": "#2C2926",
        "gitDecoration.deletedResourceForeground": "#2C2926",
        "gitDecoration.ignoredResourceForeground": "#B8B4AE",
        "gitDecoration.modifiedResourceForeground": "#7A7672",
        "gitDecoration.renamedResourceForeground": "#7A7672",
        "gitDecoration.untrackedResourceForeground": "#5A5652",
        "icon.foreground": "#3E3B36",
        "input.background": "#ECE8E2",
        "input.border": "#D4D0CA",
        "input.foreground": "#2C2926",
        "input.placeholderForeground": "#9C9892",
        "inputOption.activeBorder": "#3E3B36",
        "list.activeSelectionBackground": "#E5E1DA",
        "list.activeSelectionForeground": "#2C2926",
        "list.focusBackground": "#D4D0CA",
        "list.hoverBackground": "#ECE8E2",
        "list.hoverForeground": "#2C2926",
        "list.inactiveSelectionBackground": "#ECE8E2",
        "list.inactiveSelectionForeground": "#2C2926",
        "panel.background": "#D4D0CA",
        "panel.border": "#D4D0CA",
        "panelTitle.activeBorder": "#3E3B36",
        "panelTitle.activeForeground": "#2C2926",
        "panelTitle.inactiveForeground": "#9C9892",
        "progressBar.background": "#3E3B36",
        "quickInput.background": "#ECE8E2",
        "quickInput.foreground": "#2C2926",
        "scrollbarSlider.activeBackground": "#9C989266",
        "scrollbarSlider.background": "#9C989233",
        "scrollbarSlider.hoverBackground": "#9C989244",
        "settings.headerForeground": "#2C2926",
        "settings.modifiedItemIndicator": "#3E3B36",
        "sideBar.background": "#D4D0CA",
        "sideBar.border": "#D4D0CA",
        "sideBar.foreground": "#504D49",
        "sideBarSectionHeader.background": "#D4D0CA",
        "sideBarSectionHeader.foreground": "#2C2926",
        "sideBarTitle.foreground": "#2C2926",
        "statusBar.background": "#D4D0CA",
        "statusBar.border": "#D4D0CA",
        "statusBar.foreground": "#504D49",
        "tab.activeBackground": "#F2EDE8",
        "tab.activeBorder": "#F2EDE8",
        "tab.activeForeground": "#2C2926",
        "tab.border": "#D4D0CA",
        "tab.hoverBackground": "#ECE8E2",
        "tab.inactiveBackground": "#D4D0CA",
        "tab.inactiveForeground": "#9C9892",
        "terminal.ansiBlack": "#F2EDE8",
        "terminal.ansiBlue": "#504D49",
        "terminal.ansiBrightBlack": "#C8C4BE",
        "terminal.ansiBrightBlue": "#504D49",
        "terminal.ansiBrightCyan": "#AFABA5",
        "terminal.ansiBrightGreen": "#686461",
        "terminal.ansiBrightMagenta": "#7A7672",
        "terminal.ansiBrightRed": "#3E3B36",
        "terminal.ansiBrightWhite": "#E5E1DA",
        "terminal.ansiBrightYellow": "#9C9892",
        "terminal.ansiCyan": "#9C9892",
        "terminal.ansiGreen": "#5A5652",
        "terminal.ansiMagenta": "#686461",
        "terminal.ansiRed": "#3E3B36",
        "terminal.ansiWhite": "#AFABA5",
        "terminal.ansiYellow": "#7A7672",
        "terminal.foreground": "#2C2926",
        "textLink.foreground": "#3E3B36",
        "titleBar.activeBackground": "#D4D0CA",
        "titleBar.activeForeground": "#2C2926",
        "titleBar.border": "#D4D0CA",
        "titleBar.inactiveBackground": "#D4D0CA",
        "titleBar.inactiveForeground": "#9C9892"
    },
    "tokenColors": [
        { "scope": ["variable"],            "settings": { "foreground": "#2C2926" } },
        { "scope": ["keyword.operator", "brace", "bracket", "delimiter", "meta", "paren", "tag"],
                                            "settings": { "foreground": "#9C9892" } },
        { "scope": ["storage"],             "settings": { "foreground": "#3E3B36", "fontStyle": "bold" } },
        { "scope": ["keyword.control", "keyword.operator.new"],
                                            "settings": { "foreground": "#3E3B36", "fontStyle": "bold" } },
        { "scope": ["string"],              "settings": { "foreground": "#5A5652" } },
        { "scope": ["comment"],             "settings": { "foreground": "#B8B4AE", "fontStyle": "italic" } },
        { "scope": ["entity.name", "meta.function-call", "support.class"],
                                            "settings": { "foreground": "#2C2926", "fontStyle": "bold" } },
        { "scope": ["constant"],            "settings": { "foreground": "#7A7672" } },
        { "scope": "token.error-token",     "settings": { "foreground": "#2C2926", "fontStyle": "bold" } },
        { "scope": "token.warn-token",      "settings": { "foreground": "#7A7672" } },
        { "scope": "token.info-token",      "settings": { "foreground": "#504D49" } }
    ]
}
