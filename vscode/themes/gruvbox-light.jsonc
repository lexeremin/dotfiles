{
    "$schema": "vscode://schemas/color-theme",
    "name": "Gruvbox Light Medium",
    "type": "light",
    "colors": {
        "activityBar.activeBorder": "#d79921",
        "activityBar.background": "#d5c4a1",
        "activityBar.border": "#d5c4a1",
        "activityBar.foreground": "#3c3836",
        "activityBar.inactiveForeground": "#7c6f64",
        "activityBarBadge.background": "#d79921",
        "activityBarBadge.foreground": "#fbf1c7",
        "badge.background": "#d79921",
        "badge.foreground": "#fbf1c7",
        "breadcrumb.activeSelectionForeground": "#3c3836",
        "breadcrumb.focusForeground": "#3c3836",
        "breadcrumb.foreground": "#7c6f64",
        "breadcrumbPicker.background": "#ebdbb2",
        "button.background": "#d79921",
        "button.foreground": "#fbf1c7",
        "button.hoverBackground": "#c08010",
        "button.secondaryBackground": "#d5c4a1",
        "button.secondaryForeground": "#3c3836",
        "button.secondaryHoverBackground": "#c9b899",
        "checkbox.background": "#ebdbb2",
        "checkbox.border": "#d5c4a1",
        "diffEditor.insertedTextBackground": "#79740e30",
        "diffEditor.removedTextBackground": "#9d000630",
        "dropdown.background": "#ebdbb2",
        "dropdown.border": "#d79921",
        "dropdown.foreground": "#3c3836",
        "dropdown.listBackground": "#ebdbb2",
        "editor.background": "#fbf1c7",
        "editor.findMatchBackground": "#d7992140",
        "editor.findMatchBorder": "#d79921",
        "editor.findMatchHighlightBackground": "#d7992130",
        "editor.foreground": "#3c3836",
        "editor.inactiveSelectionBackground": "#d5c4a166",
        "editor.lineHighlightBackground": "#ebdbb2",
        "editor.selectionBackground": "#d5c4a1",
        "editor.selectionHighlightBackground": "#d5c4a144",
        "editor.wordHighlightBorder": "#7c6f6466",
        "editor.wordHighlightStrongBorder": "#7c6f64",
        "editorBracketMatch.background": "#d5c4a166",
        "editorCursor.foreground": "#d79921",
        "editorGroup.border": "#d5c4a1",
        "editorGroupHeader.tabsBackground": "#d5c4a1",
        "editorGroupHeader.tabsBorder": "#d5c4a1",
        "editorGutter.addedBackground": "#79740e",
        "editorGutter.deletedBackground": "#9d0006",
        "editorGutter.modifiedBackground": "#af3a03",
        "editorIndentGuide.activeBackground1": "#d5c4a1",
        "editorIndentGuide.background1": "#e2d9b5",
        "editorLineNumber.activeForeground": "#d79921",
        "editorLineNumber.foreground": "#7c6f64",
        "editorOverviewRuler.border": "#d5c4a1",
        "editorWhitespace.foreground": "#d5c4a1",
        "editorWidget.background": "#ebdbb2",
        "errorForeground": "#9d0006",
        "focusBorder": "#d79921",
        "foreground": "#665c54",
        "gitDecoration.addedResourceForeground": "#79740e",
        "gitDecoration.conflictingResourceForeground": "#9d0006",
        "gitDecoration.deletedResourceForeground": "#9d0006",
        "gitDecoration.ignoredResourceForeground": "#7c6f64",
        "gitDecoration.modifiedResourceForeground": "#af3a03",
        "gitDecoration.renamedResourceForeground": "#af3a03",
        "gitDecoration.untrackedResourceForeground": "#79740e",
        "icon.foreground": "#d79921",
        "input.background": "#ebdbb2",
        "input.border": "#d5c4a1",
        "input.foreground": "#3c3836",
        "input.placeholderForeground": "#7c6f64",
        "inputOption.activeBorder": "#d79921",
        "list.activeSelectionBackground": "#d5c4a1",
        "list.activeSelectionForeground": "#3c3836",
        "list.focusBackground": "#d5c4a1",
        "list.hoverBackground": "#ebdbb2",
        "list.hoverForeground": "#3c3836",
        "list.inactiveSelectionBackground": "#ebdbb2",
        "list.inactiveSelectionForeground": "#3c3836",
        "panel.background": "#d5c4a1",
        "panel.border": "#d5c4a1",
        "panelTitle.activeBorder": "#d79921",
        "panelTitle.activeForeground": "#3c3836",
        "panelTitle.inactiveForeground": "#7c6f64",
        "progressBar.background": "#d79921",
        "quickInput.background": "#ebdbb2",
        "quickInput.foreground": "#3c3836",
        "scrollbarSlider.activeBackground": "#7c6f6466",
        "scrollbarSlider.background": "#7c6f6433",
        "scrollbarSlider.hoverBackground": "#7c6f6444",
        "settings.headerForeground": "#3c3836",
        "settings.modifiedItemIndicator": "#d79921",
        "sideBar.background": "#d5c4a1",
        "sideBar.border": "#d5c4a1",
        "sideBar.foreground": "#504945",
        "sideBarSectionHeader.background": "#d5c4a1",
        "sideBarSectionHeader.foreground": "#3c3836",
        "sideBarTitle.foreground": "#3c3836",
        "statusBar.background": "#d5c4a1",
        "statusBar.border": "#d5c4a1",
        "statusBar.debuggingBackground": "#9d0006",
        "statusBar.debuggingForeground": "#fbf1c7",
        "statusBar.foreground": "#504945",
        "tab.activeBackground": "#fbf1c7",
        "tab.activeBorder": "#fbf1c7",
        "tab.activeForeground": "#3c3836",
        "tab.border": "#d5c4a1",
        "tab.hoverBackground": "#ebdbb2",
        "tab.inactiveBackground": "#d5c4a1",
        "tab.inactiveForeground": "#7c6f64",
        "terminal.ansiBlack": "#fbf1c7",
        "terminal.ansiBlue": "#458588",
        "terminal.ansiBrightBlack": "#928374",
        "terminal.ansiBrightBlue": "#076678",
        "terminal.ansiBrightCyan": "#427b58",
        "terminal.ansiBrightGreen": "#79740e",
        "terminal.ansiBrightMagenta": "#8f3f71",
        "terminal.ansiBrightRed": "#9d0006",
        "terminal.ansiBrightWhite": "#3c3836",
        "terminal.ansiBrightYellow": "#b57614",
        "terminal.ansiCyan": "#689d6a",
        "terminal.ansiGreen": "#98971a",
        "terminal.ansiMagenta": "#b16286",
        "terminal.ansiRed": "#cc241d",
        "terminal.ansiWhite": "#7c6f64",
        "terminal.ansiYellow": "#d79921",
        "terminal.foreground": "#3c3836",
        "textLink.foreground": "#d79921",
        "titleBar.activeBackground": "#d5c4a1",
        "titleBar.activeForeground": "#3c3836",
        "titleBar.border": "#d5c4a1",
        "titleBar.inactiveBackground": "#d5c4a1",
        "titleBar.inactiveForeground": "#7c6f64"
    },
    "tokenColors": [
        { "scope": ["variable"],            "settings": { "foreground": "#3c3836" } },
        { "scope": ["keyword.operator", "brace", "bracket", "delimiter", "meta", "paren", "tag"],
                                            "settings": { "foreground": "#7c6f64" } },
        { "scope": ["storage"],             "settings": { "foreground": "#9d0006" } },
        { "scope": ["keyword.control", "keyword.operator.new"],
                                            "settings": { "foreground": "#9d0006", "fontStyle": "bold" } },
        { "scope": ["string"],              "settings": { "foreground": "#79740e" } },
        { "scope": ["comment"],             "settings": { "foreground": "#7c6f64", "fontStyle": "italic" } },
        { "scope": ["entity.name", "meta.function-call", "support.class"],
                                            "settings": { "foreground": "#3c3836", "fontStyle": "bold" } },
        { "scope": ["constant"],            "settings": { "foreground": "#af3a03" } },
        { "scope": "token.error-token",     "settings": { "foreground": "#9d0006" } },
        { "scope": "token.warn-token",      "settings": { "foreground": "#af3a03" } },
        { "scope": "token.info-token",      "settings": { "foreground": "#076678" } }
    ]
}
