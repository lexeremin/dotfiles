{
    "$schema": "vscode://schemas/color-theme",
    "name": "Gruvbox Dark Medium",
    "type": "dark",
    "colors": {
        "activityBar.activeBorder": "#fabd2f",
        "activityBar.background": "#3c3836",
        "activityBar.border": "#3c3836",
        "activityBar.foreground": "#ebdbb2",
        "activityBar.inactiveForeground": "#a89984",
        "activityBarBadge.background": "#fabd2f",
        "activityBarBadge.foreground": "#282828",
        "badge.background": "#fabd2f",
        "badge.foreground": "#282828",
        "breadcrumb.activeSelectionForeground": "#ebdbb2",
        "breadcrumb.focusForeground": "#ebdbb2",
        "breadcrumb.foreground": "#a89984",
        "breadcrumbPicker.background": "#504945",
        "button.background": "#fabd2f",
        "button.foreground": "#282828",
        "button.hoverBackground": "#e0a800",
        "button.secondaryBackground": "#504945",
        "button.secondaryForeground": "#ebdbb2",
        "button.secondaryHoverBackground": "#665c54",
        "checkbox.background": "#504945",
        "checkbox.border": "#665c54",
        "diffEditor.insertedTextBackground": "#b8bb2630",
        "diffEditor.removedTextBackground": "#fb493430",
        "dropdown.background": "#504945",
        "dropdown.border": "#fabd2f",
        "dropdown.foreground": "#ebdbb2",
        "dropdown.listBackground": "#504945",
        "editor.background": "#282828",
        "editor.findMatchBackground": "#fabd2f40",
        "editor.findMatchBorder": "#fabd2f",
        "editor.findMatchHighlightBackground": "#fabd2f30",
        "editor.foreground": "#ebdbb2",
        "editor.inactiveSelectionBackground": "#504945",
        "editor.lineHighlightBackground": "#3c3836",
        "editor.selectionBackground": "#504945",
        "editor.selectionHighlightBackground": "#50494544",
        "editor.wordHighlightBorder": "#a8998466",
        "editor.wordHighlightStrongBorder": "#a89984",
        "editorBracketMatch.background": "#50494566",
        "editorCursor.foreground": "#fabd2f",
        "editorGroup.border": "#504945",
        "editorGroupHeader.tabsBackground": "#3c3836",
        "editorGroupHeader.tabsBorder": "#3c3836",
        "editorGutter.addedBackground": "#b8bb26",
        "editorGutter.deletedBackground": "#fb4934",
        "editorGutter.modifiedBackground": "#fe8019",
        "editorIndentGuide.activeBackground1": "#504945",
        "editorIndentGuide.background1": "#3c3836",
        "editorLineNumber.activeForeground": "#fabd2f",
        "editorLineNumber.foreground": "#7c6f64",
        "editorOverviewRuler.border": "#504945",
        "editorWhitespace.foreground": "#504945",
        "editorWidget.background": "#504945",
        "errorForeground": "#fb4934",
        "focusBorder": "#fabd2f",
        "foreground": "#a89984",
        "gitDecoration.addedResourceForeground": "#b8bb26",
        "gitDecoration.conflictingResourceForeground": "#fb4934",
        "gitDecoration.deletedResourceForeground": "#fb4934",
        "gitDecoration.ignoredResourceForeground": "#7c6f64",
        "gitDecoration.modifiedResourceForeground": "#fe8019",
        "gitDecoration.renamedResourceForeground": "#fe8019",
        "gitDecoration.untrackedResourceForeground": "#b8bb26",
        "icon.foreground": "#fabd2f",
        "input.background": "#504945",
        "input.border": "#665c54",
        "input.foreground": "#ebdbb2",
        "input.placeholderForeground": "#a89984",
        "inputOption.activeBorder": "#fabd2f",
        "list.activeSelectionBackground": "#504945",
        "list.activeSelectionForeground": "#ebdbb2",
        "list.focusBackground": "#504945",
        "list.hoverBackground": "#3c3836",
        "list.hoverForeground": "#ebdbb2",
        "list.inactiveSelectionBackground": "#3c3836",
        "list.inactiveSelectionForeground": "#ebdbb2",
        "panel.background": "#3c3836",
        "panel.border": "#3c3836",
        "panelTitle.activeBorder": "#fabd2f",
        "panelTitle.activeForeground": "#ebdbb2",
        "panelTitle.inactiveForeground": "#a89984",
        "progressBar.background": "#fabd2f",
        "quickInput.background": "#504945",
        "quickInput.foreground": "#ebdbb2",
        "scrollbarSlider.activeBackground": "#a8998466",
        "scrollbarSlider.background": "#a8998433",
        "scrollbarSlider.hoverBackground": "#a8998444",
        "settings.headerForeground": "#ebdbb2",
        "settings.modifiedItemIndicator": "#fabd2f",
        "sideBar.background": "#3c3836",
        "sideBar.border": "#3c3836",
        "sideBar.foreground": "#d5c4a1",
        "sideBarSectionHeader.background": "#3c3836",
        "sideBarSectionHeader.foreground": "#ebdbb2",
        "sideBarTitle.foreground": "#ebdbb2",
        "statusBar.background": "#3c3836",
        "statusBar.border": "#3c3836",
        "statusBar.debuggingBackground": "#fb4934",
        "statusBar.debuggingForeground": "#282828",
        "statusBar.foreground": "#d5c4a1",
        "tab.activeBackground": "#282828",
        "tab.activeBorder": "#282828",
        "tab.activeForeground": "#ebdbb2",
        "tab.border": "#3c3836",
        "tab.hoverBackground": "#504945",
        "tab.inactiveBackground": "#3c3836",
        "tab.inactiveForeground": "#a89984",
        "terminal.ansiBlack": "#282828",
        "terminal.ansiBlue": "#458588",
        "terminal.ansiBrightBlack": "#928374",
        "terminal.ansiBrightBlue": "#83a598",
        "terminal.ansiBrightCyan": "#8ec07c",
        "terminal.ansiBrightGreen": "#b8bb26",
        "terminal.ansiBrightMagenta": "#d3869b",
        "terminal.ansiBrightRed": "#fb4934",
        "terminal.ansiBrightWhite": "#ebdbb2",
        "terminal.ansiBrightYellow": "#fabd2f",
        "terminal.ansiCyan": "#689d6a",
        "terminal.ansiGreen": "#98971a",
        "terminal.ansiMagenta": "#b16286",
        "terminal.ansiRed": "#cc241d",
        "terminal.ansiWhite": "#a89984",
        "terminal.ansiYellow": "#d79921",
        "terminal.foreground": "#ebdbb2",
        "textLink.foreground": "#fabd2f",
        "titleBar.activeBackground": "#3c3836",
        "titleBar.activeForeground": "#ebdbb2",
        "titleBar.border": "#3c3836",
        "titleBar.inactiveBackground": "#3c3836",
        "titleBar.inactiveForeground": "#a89984"
    },
    "tokenColors": [
        { "scope": ["variable"],            "settings": { "foreground": "#ebdbb2" } },
        { "scope": ["keyword.operator", "brace", "bracket", "delimiter", "meta", "paren", "tag"],
                                            "settings": { "foreground": "#a89984" } },
        { "scope": ["storage"],             "settings": { "foreground": "#fb4934" } },
        { "scope": ["keyword.control", "keyword.operator.new"],
                                            "settings": { "foreground": "#fb4934", "fontStyle": "bold" } },
        { "scope": ["string"],              "settings": { "foreground": "#b8bb26" } },
        { "scope": ["comment"],             "settings": { "foreground": "#928374", "fontStyle": "italic" } },
        { "scope": ["entity.name", "meta.function-call", "support.class"],
                                            "settings": { "foreground": "#fabd2f", "fontStyle": "bold" } },
        { "scope": ["constant"],            "settings": { "foreground": "#d3869b" } },
        { "scope": "token.error-token",     "settings": { "foreground": "#fb4934" } },
        { "scope": "token.warn-token",      "settings": { "foreground": "#fe8019" } },
        { "scope": "token.info-token",      "settings": { "foreground": "#83a598" } }
    ]
}
