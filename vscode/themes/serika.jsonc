{
    "$schema": "vscode://schemas/color-theme",
    "name": "Serika",
    "type": "light",
    "colors": {
        "activityBar.activeBorder": "#E2B714",
        "activityBar.background": "#C8CAD0",
        "activityBar.border": "#C8CAD0",
        "activityBar.foreground": "#323437",
        "activityBar.inactiveForeground": "#AAAEB3",
        "activityBarBadge.background": "#E2B714",
        "activityBarBadge.foreground": "#323437",
        "badge.background": "#E2B714",
        "badge.foreground": "#323437",
        "breadcrumb.activeSelectionForeground": "#323437",
        "breadcrumb.focusForeground": "#323437",
        "breadcrumb.foreground": "#AAAEB3",
        "breadcrumbPicker.background": "#EAEAEC",
        "button.background": "#E2B714",
        "button.foreground": "#323437",
        "button.hoverBackground": "#CFA900",
        "button.secondaryBackground": "#D1D3D8",
        "button.secondaryForeground": "#323437",
        "button.secondaryHoverBackground": "#C4C7CC",
        "checkbox.background": "#EAEAEC",
        "checkbox.border": "#D1D3D8",
        "diffEditor.insertedTextBackground": "#6A944030",
        "diffEditor.removedTextBackground": "#DA333330",
        "dropdown.background": "#EAEAEC",
        "dropdown.border": "#E2B714",
        "dropdown.foreground": "#323437",
        "dropdown.listBackground": "#EAEAEC",
        "editor.background": "#E1E1E3",
        "editor.findMatchBackground": "#E2B71440",
        "editor.findMatchBorder": "#E2B714",
        "editor.findMatchHighlightBackground": "#E2B71430",
        "editor.foreground": "#323437",
        "editor.inactiveSelectionBackground": "#D1D3D866",
        "editor.lineHighlightBackground": "#D1D3D8",
        "editor.selectionBackground": "#D1D3D8",
        "editor.selectionHighlightBackground": "#D1D3D844",
        "editor.wordHighlightBorder": "#AAAEB366",
        "editor.wordHighlightStrongBorder": "#AAAEB3",
        "editorBracketMatch.background": "#D1D3D866",
        "editorCursor.foreground": "#E2B714",
        "editorGroup.border": "#D1D3D8",
        "editorGroupHeader.tabsBackground": "#C8CAD0",
        "editorGroupHeader.tabsBorder": "#C8CAD0",
        "editorGutter.addedBackground": "#6A9440",
        "editorGutter.deletedBackground": "#DA3333",
        "editorGutter.modifiedBackground": "#C08030",
        "editorIndentGuide.activeBackground1": "#D1D3D8",
        "editorIndentGuide.background1": "#DCDCDC",
        "editorLineNumber.activeForeground": "#E2B714",
        "editorLineNumber.foreground": "#AAAEB3",
        "editorOverviewRuler.border": "#D1D3D8",
        "editorWhitespace.foreground": "#D1D3D8",
        "editorWidget.background": "#EAEAEC",
        "errorForeground": "#DA3333",
        "focusBorder": "#E2B714",
        "foreground": "#737880",
        "gitDecoration.addedResourceForeground": "#6A9440",
        "gitDecoration.conflictingResourceForeground": "#DA3333",
        "gitDecoration.deletedResourceForeground": "#DA3333",
        "gitDecoration.ignoredResourceForeground": "#AAAEB3",
        "gitDecoration.modifiedResourceForeground": "#C08030",
        "gitDecoration.renamedResourceForeground": "#C08030",
        "gitDecoration.untrackedResourceForeground": "#6A9440",
        "icon.foreground": "#E2B714",
        "input.background": "#EAEAEC",
        "input.border": "#D1D3D8",
        "input.foreground": "#323437",
        "input.placeholderForeground": "#AAAEB3",
        "inputOption.activeBorder": "#E2B714",
        "list.activeSelectionBackground": "#D1D3D8",
        "list.activeSelectionForeground": "#323437",
        "list.focusBackground": "#D1D3D8",
        "list.hoverBackground": "#EAEAEC",
        "list.hoverForeground": "#323437",
        "list.inactiveSelectionBackground": "#EAEAEC",
        "list.inactiveSelectionForeground": "#323437",
        "panel.background": "#C8CAD0",
        "panel.border": "#C8CAD0",
        "panelTitle.activeBorder": "#E2B714",
        "panelTitle.activeForeground": "#323437",
        "panelTitle.inactiveForeground": "#AAAEB3",
        "progressBar.background": "#E2B714",
        "quickInput.background": "#EAEAEC",
        "quickInput.foreground": "#323437",
        "scrollbarSlider.activeBackground": "#AAAEB366",
        "scrollbarSlider.background": "#AAAEB333",
        "scrollbarSlider.hoverBackground": "#AAAEB344",
        "settings.headerForeground": "#323437",
        "settings.modifiedItemIndicator": "#E2B714",
        "sideBar.background": "#C8CAD0",
        "sideBar.border": "#C8CAD0",
        "sideBar.foreground": "#4A4D52",
        "sideBarSectionHeader.background": "#C8CAD0",
        "sideBarSectionHeader.foreground": "#323437",
        "sideBarTitle.foreground": "#323437",
        "statusBar.background": "#C8CAD0",
        "statusBar.border": "#C8CAD0",
        "statusBar.debuggingBackground": "#DA3333",
        "statusBar.debuggingForeground": "#E1E1E3",
        "statusBar.foreground": "#4A4D52",
        "tab.activeBackground": "#E1E1E3",
        "tab.activeBorder": "#E1E1E3",
        "tab.activeForeground": "#323437",
        "tab.border": "#C8CAD0",
        "tab.hoverBackground": "#EAEAEC",
        "tab.inactiveBackground": "#C8CAD0",
        "tab.inactiveForeground": "#AAAEB3",
        "terminal.ansiBlack": "#E1E1E3",
        "terminal.ansiBlue": "#6A7890",
        "terminal.ansiBrightBlack": "#8A8E93",
        "terminal.ansiBrightBlue": "#6A7890",
        "terminal.ansiBrightCyan": "#508080",
        "terminal.ansiBrightGreen": "#6A9440",
        "terminal.ansiBrightMagenta": "#886888",
        "terminal.ansiBrightRed": "#DA3333",
        "terminal.ansiBrightWhite": "#D1D3D8",
        "terminal.ansiBrightYellow": "#E2B714",
        "terminal.ansiCyan": "#508080",
        "terminal.ansiGreen": "#6A9440",
        "terminal.ansiMagenta": "#886888",
        "terminal.ansiRed": "#DA3333",
        "terminal.ansiWhite": "#8A8E93",
        "terminal.ansiYellow": "#C8A010",
        "terminal.foreground": "#323437",
        "textLink.foreground": "#E2B714",
        "titleBar.activeBackground": "#C8CAD0",
        "titleBar.activeForeground": "#323437",
        "titleBar.border": "#C8CAD0",
        "titleBar.inactiveBackground": "#C8CAD0",
        "titleBar.inactiveForeground": "#AAAEB3"
    },
    "tokenColors": [
        { "scope": ["variable"],            "settings": { "foreground": "#323437" } },
        { "scope": ["keyword.operator", "brace", "bracket", "delimiter", "meta", "paren", "tag"],
                                            "settings": { "foreground": "#AAAEB3" } },
        { "scope": ["storage"],             "settings": { "foreground": "#AAAEB3" } },
        { "scope": ["keyword.control", "keyword.operator.new"],
                                            "settings": { "foreground": "#323437", "fontStyle": "bold" } },
        { "scope": ["string"],              "settings": { "foreground": "#6A9440" } },
        { "scope": ["comment"],             "settings": { "foreground": "#AAAEB3", "fontStyle": "italic" } },
        { "scope": ["entity.name", "meta.function-call", "support.class"],
                                            "settings": { "foreground": "#323437", "fontStyle": "bold" } },
        { "scope": ["constant"],            "settings": { "foreground": "#C08030" } },
        { "scope": "token.error-token",     "settings": { "foreground": "#DA3333" } },
        { "scope": "token.warn-token",      "settings": { "foreground": "#C08030" } },
        { "scope": "token.info-token",      "settings": { "foreground": "#5A88B8" } }
    ]
}
