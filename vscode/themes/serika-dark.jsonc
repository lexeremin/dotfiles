{
    "$schema": "vscode://schemas/color-theme",
    "name": "Serika Dark",
    "type": "dark",
    "colors": {
        "activityBar.activeBorder": "#E2B714",
        "activityBar.background": "#252729",
        "activityBar.border": "#252729",
        "activityBar.foreground": "#E2B714",
        "activityBar.inactiveForeground": "#646669",
        "activityBarBadge.background": "#E2B714",
        "activityBarBadge.foreground": "#2C2E31",
        "badge.background": "#E2B714",
        "badge.foreground": "#2C2E31",
        "breadcrumb.activeSelectionForeground": "#D1D0C5",
        "breadcrumb.focusForeground": "#D1D0C5",
        "breadcrumb.foreground": "#646669",
        "breadcrumbPicker.background": "#3A3D40",
        "button.background": "#E2B714",
        "button.foreground": "#2C2E31",
        "button.hoverBackground": "#CFA900",
        "button.secondaryBackground": "#3A3D40",
        "button.secondaryForeground": "#D1D0C5",
        "button.secondaryHoverBackground": "#4A4D52",
        "checkbox.background": "#3A3D40",
        "checkbox.border": "#2C2E31",
        "diffEditor.insertedTextBackground": "#78A85230",
        "diffEditor.removedTextBackground": "#CA475430",
        "dropdown.background": "#3A3D40",
        "dropdown.border": "#E2B714",
        "dropdown.foreground": "#D1D0C5",
        "dropdown.listBackground": "#3A3D40",
        "editor.background": "#323437",
        "editor.findMatchBackground": "#E2B71440",
        "editor.findMatchBorder": "#E2B714",
        "editor.findMatchHighlightBackground": "#E2B71430",
        "editor.foreground": "#D1D0C5",
        "editor.inactiveSelectionBackground": "#4A4D5266",
        "editor.lineHighlightBackground": "#2C2E31",
        "editor.selectionBackground": "#4A4D52",
        "editor.selectionHighlightBackground": "#4A4D5244",
        "editor.wordHighlightBorder": "#64666966",
        "editor.wordHighlightStrongBorder": "#8A8E93",
        "editorBracketMatch.background": "#4A4D5266",
        "editorCursor.foreground": "#E2B714",
        "editorGroup.border": "#3A3D40",
        "editorGroupHeader.tabsBackground": "#252729",
        "editorGroupHeader.tabsBorder": "#252729",
        "editorGutter.addedBackground": "#78A852",
        "editorGutter.deletedBackground": "#CA4754",
        "editorGutter.modifiedBackground": "#E2B714",
        "editorIndentGuide.activeBackground1": "#4A4D52",
        "editorIndentGuide.background1": "#3A3D40",
        "editorLineNumber.activeForeground": "#E2B714",
        "editorLineNumber.foreground": "#646669",
        "editorOverviewRuler.border": "#252729",
        "editorWhitespace.foreground": "#3A3D40",
        "editorWidget.background": "#3A3D40",
        "errorForeground": "#CA4754",
        "focusBorder": "#E2B714",
        "foreground": "#8A8E93",
        "gitDecoration.addedResourceForeground": "#78A852",
        "gitDecoration.conflictingResourceForeground": "#CA4754",
        "gitDecoration.deletedResourceForeground": "#CA4754",
        "gitDecoration.ignoredResourceForeground": "#646669",
        "gitDecoration.modifiedResourceForeground": "#E2B714",
        "gitDecoration.renamedResourceForeground": "#D4A332",
        "gitDecoration.untrackedResourceForeground": "#D4A332",
        "icon.foreground": "#E2B714",
        "input.background": "#3A3D40",
        "input.border": "#2C2E31",
        "input.foreground": "#D1D0C5",
        "input.placeholderForeground": "#646669",
        "inputOption.activeBorder": "#E2B714",
        "list.activeSelectionBackground": "#3A3D40",
        "list.activeSelectionForeground": "#D1D0C5",
        "list.focusBackground": "#4A4D52",
        "list.hoverBackground": "#3A3D40",
        "list.hoverForeground": "#D1D0C5",
        "list.inactiveSelectionBackground": "#3A3D40",
        "list.inactiveSelectionForeground": "#D1D0C5",
        "panel.background": "#252729",
        "panel.border": "#252729",
        "panelTitle.activeBorder": "#E2B714",
        "panelTitle.activeForeground": "#D1D0C5",
        "panelTitle.inactiveForeground": "#646669",
        "progressBar.background": "#E2B714",
        "quickInput.background": "#3A3D40",
        "quickInput.foreground": "#D1D0C5",
        "scrollbarSlider.activeBackground": "#64666966",
        "scrollbarSlider.background": "#64666933",
        "scrollbarSlider.hoverBackground": "#64666944",
        "settings.headerForeground": "#D1D0C5",
        "settings.modifiedItemIndicator": "#E2B714",
        "sideBar.background": "#252729",
        "sideBar.border": "#252729",
        "sideBar.foreground": "#8A8E93",
        "sideBarSectionHeader.background": "#252729",
        "sideBarSectionHeader.foreground": "#D1D0C5",
        "sideBarTitle.foreground": "#D1D0C5",
        "statusBar.background": "#252729",
        "statusBar.border": "#252729",
        "statusBar.debuggingBackground": "#CA4754",
        "statusBar.debuggingForeground": "#D1D0C5",
        "statusBar.foreground": "#8A8E93",
        "tab.activeBackground": "#323437",
        "tab.activeBorder": "#323437",
        "tab.activeForeground": "#D1D0C5",
        "tab.border": "#252729",
        "tab.hoverBackground": "#3A3D40",
        "tab.inactiveBackground": "#252729",
        "tab.inactiveForeground": "#646669",
        "terminal.ansiBlack": "#323437",
        "terminal.ansiBlue": "#6A9AB0",
        "terminal.ansiBrightBlack": "#4A4D52",
        "terminal.ansiBrightBlue": "#6A9AB0",
        "terminal.ansiBrightCyan": "#5A9898",
        "terminal.ansiBrightGreen": "#78A852",
        "terminal.ansiBrightMagenta": "#9A80B0",
        "terminal.ansiBrightRed": "#CA4754",
        "terminal.ansiBrightWhite": "#D1D0C5",
        "terminal.ansiBrightYellow": "#E2B714",
        "terminal.ansiCyan": "#5A9898",
        "terminal.ansiGreen": "#78A852",
        "terminal.ansiMagenta": "#9A80B0",
        "terminal.ansiRed": "#CA4754",
        "terminal.ansiWhite": "#9A9E9F",
        "terminal.ansiYellow": "#E2B714",
        "terminal.foreground": "#D1D0C5",
        "textLink.foreground": "#E2B714",
        "titleBar.activeBackground": "#252729",
        "titleBar.activeForeground": "#D1D0C5",
        "titleBar.border": "#252729",
        "titleBar.inactiveBackground": "#252729",
        "titleBar.inactiveForeground": "#646669"
    },
    "tokenColors": [
        { "scope": ["variable"],            "settings": { "foreground": "#D1D0C5" } },
        { "scope": ["keyword.operator", "brace", "bracket", "delimiter", "meta", "paren", "tag"],
                                            "settings": { "foreground": "#646669" } },
        { "scope": ["storage"],             "settings": { "foreground": "#646669" } },
        { "scope": ["keyword.control", "keyword.operator.new"],
                                            "settings": { "foreground": "#D1D0C5", "fontStyle": "bold" } },
        { "scope": ["string"],              "settings": { "foreground": "#78A852" } },
        { "scope": ["comment"],             "settings": { "foreground": "#646669", "fontStyle": "italic" } },
        { "scope": ["entity.name", "meta.function-call", "support.class"],
                                            "settings": { "foreground": "#E2B714" } },
        { "scope": ["constant"],            "settings": { "foreground": "#D4A332" } },
        { "scope": "token.error-token",     "settings": { "foreground": "#CA4754" } },
        { "scope": "token.warn-token",      "settings": { "foreground": "#D4A332" } },
        { "scope": "token.info-token",      "settings": { "foreground": "#6A9AB0" } }
    ]
}
