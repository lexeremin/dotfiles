{
    "$schema": "vscode://schemas/color-theme",
    "name": "Mono",
    "type": "light",
    "colors": {
        "activityBar.activeBorder": "#3C3C3C",
        "activityBar.background": "#D0D0D0",
        "activityBar.border": "#D0D0D0",
        "activityBar.foreground": "#1E1E1E",
        "activityBar.inactiveForeground": "#888888",
        "activityBarBadge.background": "#3C3C3C",
        "activityBarBadge.foreground": "#E8E8E8",
        "badge.background": "#3C3C3C",
        "badge.foreground": "#E8E8E8",
        "breadcrumb.activeSelectionForeground": "#1E1E1E",
        "breadcrumb.focusForeground": "#1E1E1E",
        "breadcrumb.foreground": "#666666",
        "breadcrumbPicker.background": "#F0F0F0",
        "button.background": "#3C3C3C",
        "button.foreground": "#E8E8E8",
        "button.hoverBackground": "#555555",
        "button.secondaryBackground": "#DCDCDC",
        "button.secondaryForeground": "#1E1E1E",
        "button.secondaryHoverBackground": "#CDCDCD",
        "checkbox.background": "#F0F0F0",
        "checkbox.border": "#CDCDCD",
        "diffEditor.insertedTextBackground": "#5A5A5A20",
        "diffEditor.removedTextBackground": "#1E1E1E20",
        "dropdown.background": "#F0F0F0",
        "dropdown.border": "#3C3C3C",
        "dropdown.foreground": "#1E1E1E",
        "dropdown.listBackground": "#F0F0F0",
        "editor.background": "#E8E8E8",
        "editor.findMatchBackground": "#88888840",
        "editor.findMatchBorder": "#888888",
        "editor.findMatchHighlightBackground": "#88888830",
        "editor.foreground": "#1E1E1E",
        "editor.inactiveSelectionBackground": "#CDCDCD66",
        "editor.lineHighlightBackground": "#DCDCDC",
        "editor.selectionBackground": "#CDCDCD",
        "editor.selectionHighlightBackground": "#CDCDCD44",
        "editor.wordHighlightBackground": "#CDCDCD00",
        "editor.wordHighlightBorder": "#66666666",
        "editor.wordHighlightStrongBackground": "#CDCDCD00",
        "editor.wordHighlightStrongBorder": "#666666",
        "editorBracketMatch.background": "#CDCDCD66",
        "editorBracketMatch.border": "#3C3C3C00",
        "editorCursor.foreground": "#1E1E1E",
        "editorGroup.border": "#DCDCDC",
        "editorGroupHeader.tabsBackground": "#D0D0D0",
        "editorGroupHeader.tabsBorder": "#D0D0D0",
        "editorGutter.addedBackground": "#5A5A5A",
        "editorGutter.deletedBackground": "#3C3C3C",
        "editorGutter.modifiedBackground": "#888888",
        "editorIndentGuide.activeBackground1": "#CDCDCD",
        "editorIndentGuide.background1": "#DCDCDC",
        "editorLineNumber.activeForeground": "#3C3C3C",
        "editorLineNumber.foreground": "#888888",
        "editorOverviewRuler.border": "#CDCDCD",
        "editorWhitespace.foreground": "#DCDCDC",
        "editorWidget.background": "#F0F0F0",
        "errorForeground": "#1E1E1E",
        "focusBorder": "#3C3C3C",
        "foreground": "#666666",
        "gitDecoration.addedResourceForeground": "#5A5A5A",
        "gitDecoration.conflictingResourceForeground": "#1E1E1E",
        "gitDecoration.deletedResourceForeground": "#1E1E1E",
        "gitDecoration.ignoredResourceForeground": "#AAAAAA",
        "gitDecoration.modifiedResourceForeground": "#3C3C3C",
        "gitDecoration.renamedResourceForeground": "#888888",
        "gitDecoration.untrackedResourceForeground": "#666666",
        "icon.foreground": "#3C3C3C",
        "input.background": "#F0F0F0",
        "input.border": "#CDCDCD",
        "input.foreground": "#1E1E1E",
        "input.placeholderForeground": "#888888",
        "inputOption.activeBorder": "#3C3C3C",
        "list.activeSelectionBackground": "#DCDCDC",
        "list.activeSelectionForeground": "#1E1E1E",
        "list.focusBackground": "#CDCDCD",
        "list.hoverBackground": "#F0F0F0",
        "list.hoverForeground": "#1E1E1E",
        "list.inactiveSelectionBackground": "#F0F0F0",
        "list.inactiveSelectionForeground": "#1E1E1E",
        "panel.background": "#D0D0D0",
        "panel.border": "#D0D0D0",
        "panelTitle.activeBorder": "#3C3C3C",
        "panelTitle.activeForeground": "#1E1E1E",
        "panelTitle.inactiveForeground": "#888888",
        "progressBar.background": "#3C3C3C",
        "quickInput.background": "#F0F0F0",
        "quickInput.foreground": "#1E1E1E",
        "scrollbarSlider.activeBackground": "#66666666",
        "scrollbarSlider.background": "#66666633",
        "scrollbarSlider.hoverBackground": "#66666644",
        "settings.headerForeground": "#1E1E1E",
        "settings.modifiedItemIndicator": "#3C3C3C",
        "sideBar.background": "#D0D0D0",
        "sideBar.border": "#D0D0D0",
        "sideBar.foreground": "#3C3C3C",
        "sideBarSectionHeader.background": "#D0D0D0",
        "sideBarSectionHeader.foreground": "#1E1E1E",
        "sideBarTitle.foreground": "#1E1E1E",
        "statusBar.background": "#D0D0D0",
        "statusBar.border": "#D0D0D0",
        "statusBar.foreground": "#3C3C3C",
        "tab.activeBackground": "#E8E8E8",
        "tab.activeBorder": "#E8E8E8",
        "tab.activeForeground": "#1E1E1E",
        "tab.border": "#D0D0D0",
        "tab.hoverBackground": "#F0F0F0",
        "tab.inactiveBackground": "#D0D0D0",
        "tab.inactiveForeground": "#888888",
        "terminal.ansiBlack": "#E8E8E8",
        "terminal.ansiBlue": "#333333",
        "terminal.ansiBrightBlack": "#5A5A5A",
        "terminal.ansiBrightBlue": "#333333",
        "terminal.ansiBrightCyan": "#4A4A4A",
        "terminal.ansiBrightGreen": "#666666",
        "terminal.ansiBrightMagenta": "#555555",
        "terminal.ansiBrightRed": "#444444",
        "terminal.ansiBrightWhite": "#CDCDCD",
        "terminal.ansiBrightYellow": "#888888",
        "terminal.ansiCyan": "#4A4A4A",
        "terminal.ansiGreen": "#666666",
        "terminal.ansiMagenta": "#555555",
        "terminal.ansiRed": "#444444",
        "terminal.ansiWhite": "#AAAAAA",
        "terminal.ansiYellow": "#888888",
        "terminal.foreground": "#1E1E1E",
        "textLink.foreground": "#3C3C3C",
        "titleBar.activeBackground": "#D0D0D0",
        "titleBar.activeForeground": "#1E1E1E",
        "titleBar.border": "#D0D0D0",
        "titleBar.inactiveBackground": "#D0D0D0",
        "titleBar.inactiveForeground": "#888888"
    },
    "tokenColors": [
        { "scope": ["variable"],            "settings": { "foreground": "#1E1E1E" } },
        { "scope": ["keyword.operator", "brace", "bracket", "delimiter", "meta", "paren", "tag"],
                                            "settings": { "foreground": "#666666" } },
        { "scope": ["storage"],             "settings": { "foreground": "#666666" } },
        { "scope": ["keyword.control", "keyword.operator.new"],
                                            "settings": { "foreground": "#1E1E1E", "fontStyle": "bold" } },
        { "scope": ["string"],              "settings": { "foreground": "#5A5A5A" } },
        { "scope": ["comment"],             "settings": { "foreground": "#888888", "fontStyle": "italic" } },
        { "scope": ["entity.name", "meta.function-call", "support.class"],
                                            "settings": { "foreground": "#1E1E1E", "fontStyle": "bold" } },
        { "scope": ["constant"],            "settings": { "foreground": "#888888" } },
        { "scope": "token.error-token",     "settings": { "foreground": "#1E1E1E", "fontStyle": "bold" } },
        { "scope": "token.warn-token",      "settings": { "foreground": "#666666" } },
        { "scope": "token.info-token",      "settings": { "foreground": "#3C3C3C" } }
    ]
}
